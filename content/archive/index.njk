---
eleventyExcludeFromCollections: true
layout: page.njk
title: Blog Archiv
---

<div class="pb-8 mt-2 font-light dark:font-extralight">
    {% for post in collections.posts | reverse %}
        {% set currentYear = post | year %}
        {% set previousPost = collections.posts | getPreviousCollectionItem(post) %}
        {% set previousYear = previousPost ? (previousPost | year) : null %}

        {% if loop.first %}
            <h4 class="mt-8 mb-1 text-xl font-medium leading-tight text-neutral-800 dark:text-neutral-50">
                {{ currentYear }}
            </h4>

            <ul class="mt-2">
        {% endif %}

        <li class="flex items-center mb-1 px-2 py-1">
            <span class="w-32 shrink-0 text-lg tabular-nums text-neutral-500">
                {{ post.date | day }} {{ post.date | month }}
            </span>

            <a href="{{ post.url }}" class="truncate hover:underline">
                {{ post.data.title }}
            </a>
        </li>

        {% if loop.last %}
            </ul>

        {% elif currentYear != previousYear %}
            </ul>

            <h4 class="mt-8 mb-1 text-xl font-medium leading-tight text-neutral-800 dark:text-neutral-50">
                {{ previousYear }}
            </h4>

            <ul class="mt-2">
        {% endif %}
    {% endfor %}
</div>